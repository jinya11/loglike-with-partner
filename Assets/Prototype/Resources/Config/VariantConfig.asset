  - id: forest_firefly
    name: "\uBC18\uB527\uBD88 \uC232"
    desc: "\uBC24\uC758 \uC232. \uD769\uC5B4\uC9C4 \uBC18\uB527\uBD88\uC744 \uBAA8\uC544
      \uB4F1\uBD88\uC744 \uCF1C\uBA74 \uADF8 \uAD6C\uC5ED\uC774 \uBC1D\uC544\uC9C0\uACE0
      \uC548\uC804\uC9C0\uB300\uAC00 \uB41C\uB2E4."
    regionScene: Region_Forest
    scene: Region_Forest_Firefly
    requiredTrait: 9
    kind: 0
    color: {r: 0.65, g: 1, b: 0.45, a: 1}
    environmentKillsCount: 0
    autoProps: 0
    enemyBias: 3
    enemyBiasMul: 3
  - id: forest_farmland
    name: "\uC790\uC5F0 \uB18D\uC9C0"
    desc: "\uBCBC \uB18D\uC0AC\uAC00 \uC774\uB8E8\uC5B4\uC9C4 \uACF3. \uC2A4\uD14C\uC774\uC9C0
      \uC804\uCCB4\uAC00 \uBCBC\uB85C \uB458\uB7EC\uC2F8\uC774\uACE0 \uBCBC\uAC00\uB8E8\uAC00
      \uD718\uB0A0\uB9B0\uB2E4. \uD0A4 \uD070 \uBCBC \uC18D\uC758 \uC801\uC740 \uBCF4\uC774\uC9C0
      \uC54A\uB294\uB2E4 \u2014 \uD3ED\uACA9\uC73C\uB85C \uBCBC\uB97C \uBCA0\uBA74
      \uB4DC\uB7EC\uB09C\uB2E4."
    regionScene: Region_Forest
    scene: Region_Forest_Farmland
    requiredTrait: 8
    kind: 1
    color: {r: 1, g: 0.85, b: 0.35, a: 1}
    environmentKillsCount: 0
    autoProps: 0
    enemyBias: 2
    enemyBiasMul: 3
  - id: desert_sandstorm
    name: "\uBAA8\uB798\uD3ED\uD48D \uC0AC\uB9C9"
    desc: "\uC8FC\uAE30\uC801\uC73C\uB85C \uBAA8\uB798\uD3ED\uD48D\uC774 \uC9C0\uB098\uAC00\uBA70
      \uBAA8\uB450\uB97C \uD55C \uBC29\uD5A5\uC73C\uB85C \uBBFC\uB2E4. \uB3D9\uAD74
      \uBC14\uC704 \uB4A4\uAC00 \uD53C\uB09C\uCC98, \uD3ED\uD48D \uB4A4\uC5D0 \uBB3B\uD78C
      \uC720\uBB3C\uC774 \uB4DC\uB7EC\uB09C\uB2E4."
    regionScene: Region_Desert
    scene: Region_Desert_Sandstorm
    requiredTrait: 11
    kind: 2
    color: {r: 1, g: 0.78, b: 0.45, a: 1}
    environmentKillsCount: 0
    autoProps: 0
    enemyBias: 1
    enemyBiasMul: 2
  - id: snow_frozenlake
    name: "\uC5BC\uC5B4\uBD99\uC740 \uD638\uC218"
    desc: "\uC5BC\uC74C\uD310 \uC704\uC758 \uC804\uC7A5. \uAE08 \uAC04 \uC5BC\uC74C\uC740
      \uAE68\uC9C0\uACE0, \uBB3C\uC5D0 \uBE60\uC9C4 \uC801\uC740 \uC989\uC0AC\uD55C\uB2E4.
      \uC791\uC740 \uC0DD\uBA85\uCCB4\uB3C4 \uBE60\uC9C8 \uC218 \uC788\uB2E4."
