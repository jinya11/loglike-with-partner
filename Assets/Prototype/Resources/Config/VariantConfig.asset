  - id: volcano_caldera
    name: "\uCE7C\uB370\uB77C"
    desc: "\uC6A9\uC554 \uD638\uC218\uB97C \uB458\uB7EC\uC2FC \uACE0\uB9AC \uBAA8\uC591
